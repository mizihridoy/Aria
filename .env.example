# ==========================================
# Aria — Discord AI Agent Environment Config
# ==========================================

# --- Node Environment ---
NODE_ENV=production
LOG_LEVEL=info

# --- Discord Configuration ---
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_DEV_GUILD_ID=

# --- AI Provider API Keys ---
# Primary Vision & Intelligence: Google Gemini (https://aistudio.google.com/)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Fast Reasoning & Multi-Tool Calling: Groq (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# AI Model Overrides (Optional Defaults)
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=gemini-embedding-001

# --- Supabase Database Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Supercell Official Clash of Clans API (Optional) ---
# Obtain from https://developer.clashofclans.com/
COC_API_TOKEN=your_supercell_api_token_here
COC_API_BASE_URL=https://api.clashofclans.com/v1
